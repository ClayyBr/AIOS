{
    "name": "atendente-whatsapp",
    "version": "1.0.0",
    "description": "Agente IA Atendente WhatsApp — Squad CFO",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "lint": "eslint src/ --ext .ts",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "keywords": [
        "whatsapp",
        "ai",
        "gemini",
        "chatbot",
        "restaurant"
    ],
    "author": "Squad CFO",
    "license": "UNLICENSED",
    "private": true,
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "@google/genai": "^1.44.0",
        "dotenv": "^16.4.0",
        "express": "^4.21.0",
        "googleapis": "^140.0.0",
        "pino": "^8.19.0",
        "pino-pretty": "^10.3.0",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.0",
        "@types/supertest": "^7.2.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "prettier": "^3.2.0",
        "supertest": "^7.2.2",
        "tsx": "^4.7.0",
        "typescript": "^5.4.0",
        "vitest": "^1.3.0"
    }
}
