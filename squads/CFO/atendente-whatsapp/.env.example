# Variáveis de Ambiente — Agente Atendente WhatsApp

# ============================
# Meta WhatsApp Cloud API
# ============================
# Token customizado para verificação do webhook (você define)
META_VERIFY_TOKEN=meu_token_de_verificacao

# Token do System User (obtido no painel Meta for Developers)
META_ACCESS_TOKEN=

# ID interno do número WhatsApp (obtido no painel Meta)
META_PHONE_NUMBER_ID=

# App Secret da aplicação Meta (para validação de assinatura)
META_APP_SECRET=

# ============================
# Google AI Studio (Gemini)
# ============================
# API Key obtida em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ============================
# Google Sheets
# ============================
# Credenciais do Service Account em base64
# Gerar: cat service-account.json | base64 -w 0
GOOGLE_SHEETS_CREDENTIALS=

# ID da planilha do cardápio (extrair da URL do Sheets)
SHEETS_CARDAPIO_ID=

# ID da planilha de pedidos (pode ser a mesma, abas diferentes)
SHEETS_PEDIDOS_ID=

# ============================
# Pagamento Pix
# ============================
# Chave Pix do restaurante (email, CPF, telefone ou aleatória)
PIX_KEY=

# Nome do recebedor que aparece na transferência
PIX_RECEIVER_NAME=

# ============================
# Configuração do Agente
# ============================
# Timeout de sessão inativa (minutos)
SESSION_TIMEOUT_MINUTES=30

# Cache do cardápio (minutos)
CARDAPIO_CACHE_MINUTES=15

# Prazo estimado de entrega (minutos)
ESTIMATED_DELIVERY_MINUTES=50

# Porta do servidor
PORT=3000

# Ambiente
NODE_ENV=development
